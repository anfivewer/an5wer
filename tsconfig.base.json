{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": "src",
    "useDefineForClassFields": true,
    "strict": true
  }
}
